# ==========================================================================
# MineDesk - example environment. Copy to .env and replace every placeholder.
#   cp .env.example .env
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NEVER commit the real .env file.
# ==========================================================================

# ---------- Core ----------
NODE_ENV=development
LOG_LEVEL=debug

# ---------- API server ----------
API_HOST=0.0.0.0
API_PORT=4000
# Public origin of the API, used to build links inside emails.
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# ---------- Database ----------
POSTGRES_USER=minedesk
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=minedesk
DATABASE_URL=postgresql://minedesk:change-me-postgres@localhost:5432/minedesk?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth / crypto ----------
# HS256 signing key for short-lived access tokens (>= 32 chars).
JWT_SECRET=replace-with-64-random-bytes-base64url
# Separate key so an agent token can never be replayed as a user token.
AGENT_JWT_SECRET=replace-with-a-different-64-random-bytes-base64url
# 32-byte base64url key used for AES-256-GCM encryption of TOTP secrets at rest.
ENCRYPTION_KEY=replace-with-32-random-bytes-base64url
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30
AGENT_TOKEN_TTL=15m

# ---------- Email (verification / password reset) ----------
# console = print the message to the log (development default). smtp = real delivery.
MAIL_TRANSPORT=console
MAIL_FROM="MineDesk <no-reply@minedesk.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- WebRTC / ICE ----------
STUN_SERVER=stun:localhost:3478
TURN_SERVER=turn:localhost:3478
TURN_USERNAME=minedesk
TURN_PASSWORD=change-me-turn
# Shared secret for RFC5766 ephemeral TURN credentials (preferred over static user/pass).
TURN_STATIC_SECRET=replace-with-32-random-bytes-base64url
TURN_REALM=minedesk.local
TURN_CREDENTIAL_TTL=3600

# ---------- Frontend (Vite: only VITE_* reach the browser bundle) ----------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
