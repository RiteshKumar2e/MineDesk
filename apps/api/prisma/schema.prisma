// MineDesk data model.
//
// Rules that shaped this schema:
//   * Everything hangs off User with ON DELETE CASCADE, so deleting an account
//     really removes the account.
//   * No secret is ever stored in a reversible form except the TOTP seed, which
//     must be reversible to verify codes and is therefore AES-256-GCM encrypted
//     with a key that lives outside the database.
//   * Audit rows survive the deletion of the session they describe (SetNull),
//     because the security record must outlive the thing it records.

// SQLite/libSQL (Turso) datasource. Enums and native arrays don't exist on
// this connector - the four enums that used to live here (DeviceOs,
// DeviceStatus, SessionStatus, VerificationTokenType) are now plain String
// columns, validated the same way they always were meant to be validated:
// by the zod schemas at the API boundary (see modules/*/schemas.ts), not by
// the database. The `[]`-suffixed fields below (twoFactorBackupCodes,
// sharedFolders, grantedCapabilities) are Json instead of String[] for the
// same reason - see lib/json.ts's `asStringArray` for how application code
// reads them back as the plain string arrays they always logically were.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  emailVerified Boolean  @default(false)

  // Two-factor authentication (TOTP). The secret is encrypted at rest.
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  /// string[] of hashed backup codes, stored as Json - see the file-level comment.
  twoFactorBackupCodes   Json     @default("[]")

  // Brute-force protection state, kept here so it survives a Redis flush.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authSessions       AuthSession[]
  devices            Device[]
  verificationTokens VerificationToken[]
  remoteSessions     RemoteSession[]
  auditLogs          AuditLog[]

  @@index([email])
  @@map("users")
}

/// One row per signed-in browser. Holds a refresh-token family; rotating the
/// token updates tokenHash in place and bumps rotationCounter.
model AuthSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque refresh token. The token itself is never stored.
  tokenHash       String    @unique
  /// Hash of the token this one replaced. Presenting it again is a replay and
  /// revokes the whole session - see rotateRefreshToken().
  previousTokenHash String?
  /// Set when the token has been rotated away.
  replacedAt      DateTime?
  rotationCounter Int       @default(0)
  revokedAt       DateTime?
  revokedReason   String?

  ipAddress String?
  userAgent String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([previousTokenHash])
  @@map("auth_sessions")
}

/// Single-use, hashed tokens for email verification and password reset.
model VerificationToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'email_verification' | 'password_reset' - see lib/../modules/auth/service.ts's
  /// local VerificationTokenType union, the actual source of truth now.
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Device {
  id       String @id @default(uuid())
  /// Human-shareable identifier, e.g. RMT-8F32-A91C
  deviceId String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  /// 'windows' | 'macos' | 'linux' | 'unknown' - see @minedesk/types' DeviceOs.
  os           String    @default("unknown")
  osVersion    String?
  agentVersion String?
  hostname     String?
  /// 'online' | 'offline' - see @minedesk/types' DeviceStatus.
  status       String    @default("offline")
  lastSeenAt   DateTime?

  /// Argon2 hash of the agent credential. Rotating it revokes the agent.
  agentSecretHash String?
  enrolledAt      DateTime?

  /// Unattended access is opt-in and requires a separate access password.
  unattendedAccessEnabled  Boolean @default(false)
  unattendedPasswordHash   String?

  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  permissions     DevicePermission?
  enrollmentCodes EnrollmentCode[]
  remoteSessions  RemoteSession[]
  auditLogs       AuditLog[]

  @@index([userId, status])
  @@index([lastSeenAt])
  @@map("devices")
}

/// The capability mask enforced by the API and re-checked by the agent.
model DevicePermission {
  id       String @id @default(uuid())
  deviceId String @unique
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  screen       Boolean @default(true)
  mouse        Boolean @default(true)
  keyboard     Boolean @default(true)
  clipboard    Boolean @default(true)
  fileUpload   Boolean @default(false)
  fileDownload Boolean @default(false)
  fileDelete   Boolean @default(false)
  audio        Boolean @default(false)
  camera       Boolean @default(false)
  microphone   Boolean @default(false)

  /// string[] of absolute paths shared for file transfer, stored as Json -
  /// see the file-level comment. Empty = no file access.
  sharedFolders Json @default("[]")

  updatedAt DateTime @updatedAt

  @@map("device_permissions")
}

/// One-time code exchanged by the agent for permanent credentials.
model EnrollmentCode {
  id       String  @id @default(uuid())
  code     String  @unique
  deviceId String
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  usedIp    String?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("enrollment_codes")
}

model RemoteSession {
  id        String @id @default(uuid())
  /// Human-readable identifier, e.g. SES-2026-8F92A12
  sessionId String @unique

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// 'pending'|'active'|'reconnecting'|'ended'|'denied'|'failed' - see
  /// @minedesk/types' SessionStatus.
  status String @default("pending")

  /// Snapshot of the capabilities authorized when the session was created, so
  /// that later permission edits cannot silently widen a running session.
  /// string[] of Capability values, stored as Json - see the file-level comment.
  grantedCapabilities Json    @default("[]")
  unattended          Boolean @default(false)

  /// Which capabilities actually became active during the session.
  usedCamera     Boolean @default(false)
  usedMicrophone Boolean @default(false)
  usedAudio      Boolean @default(false)
  usedClipboard  Boolean @default(false)
  usedFiles      Boolean @default(false)

  controllerIp String?
  agentIp      String?
  /// direct | relay | unknown - filled in from the selected ICE candidate pair.
  connectionType String?
  endReason      String?

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  endedAt     DateTime?

  auditLogs AuditLog[]

  @@index([userId, requestedAt])
  @@index([deviceId, requestedAt])
  @@index([status])
  @@map("remote_sessions")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  sessionId String?
  session   RemoteSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  action    String
  ipAddress String?
  userAgent String?
  /// Structured context. Never contains passwords, tokens or file contents.
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([sessionId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
